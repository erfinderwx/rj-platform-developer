# Start the Luchs driver at boot (after the CAN interface).
# Edit User, the workspace path and the launch arguments (Luchs B: luchs_b launch file), then:
#   sudo cp luchs-driver.service /etc/systemd/system/ && sudo systemctl enable --now luchs-driver
[Unit]
Description=Luchs chassis ROS 2 driver
After=luchs-can.service
Requires=luchs-can.service

[Service]
User=robot
Environment=ROS_DOMAIN_ID=0
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source $HOME/luchs_ws/install/setup.bash && exec ros2 launch luchs_bringup luchs_a.launch.py build:=4ws'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
