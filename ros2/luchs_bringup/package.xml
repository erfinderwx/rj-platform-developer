<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>luchs_bringup</name>
  <version>1.1.0</version>
  <description>Launch files, CAN setup script, udev rule and systemd unit for Luchs robot chassis.</description>
  <maintainer email="support@terraagent-robotics.com">TerraAgent Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>luchs_driver</exec_depend>
  <exec_depend>luchs_description</exec_depend>
  <exec_depend>luchs_teleop</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
