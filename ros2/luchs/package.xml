<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>luchs</name>
  <version>1.1.0</version>
  <description>Metapackage for Luchs robot chassis software (TerraAgent Robotics, chassis by RJ Tech Limited).</description>
  <maintainer email="support@terraagent-robotics.com">TerraAgent Robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>luchs_sdk</exec_depend>
  <exec_depend>luchs_msgs</exec_depend>
  <exec_depend>luchs_driver</exec_depend>
  <exec_depend>luchs_description</exec_depend>
  <exec_depend>luchs_bringup</exec_depend>
  <exec_depend>luchs_teleop</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
