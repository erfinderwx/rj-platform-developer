CM_ BO_ 1793 "Host -> VCU, 10 ms. Identifier written \"701\" in the sheet; hexadecimal TO CONFIRM";
CM_ SG_ 1793 Heartbeat "0-255, increment every frame";
CM_ SG_ 1793 RemoteEnable "0 handset (RC), 1 upper computer";
CM_ SG_ 1793 SteerRate "50-520";
CM_ SG_ 1793 SpeedCap "Target speed limit 0-30";
CM_ SG_ 1793 SteerAngle "Road-wheel angle -42..42. Sign TO CONFIRM (EPS sheet: clockwise = positive)";
CM_ SG_ 1793 Brake "Brake pedal 0-100";
CM_ SG_ 1793 Throttle "Accelerator pedal 0-100";
CM_ BO_ 1795 "VCU -> host, 10 ms";
CM_ SG_ 1795 Speed "Unsigned, 1 km/h; direction from Gear";
CM_ SG_ 1795 Current "Range -200..200 A in the sheet; offset TO CONFIRM";
