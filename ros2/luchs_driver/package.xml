<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>luchs_driver</name>
  <version>1.1.0</version>
  <description>
    ROS 2 driver for Luchs A and Luchs B robot chassis over SocketCAN (Luchs A protocol, LCI,
    Luchs B VCU interface): cmd_vel in; odometry, TF, joint states, chassis and safety state,
    battery state, chassis IMU and diagnostics out. Command and feedback watchdogs, LCI heartbeat,
    live chassis limits, acceleration and steering limits.
  </description>
  <maintainer email="support@terraagent-robotics.com">TerraAgent Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>luchs_sdk</depend>
  <depend>luchs_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>diagnostic_updater</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
