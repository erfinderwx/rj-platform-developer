<!-- Luchs B (LCI) against the built-in simulator: odometry, state and chassis IMU are published. -->
<launch>
  <include file="$(find luchs_bringup)/launch/luchs_b.launch"><arg name="dry_run" value="true"/></include>
  <test test-name="odom_hz_b" pkg="rostest" type="hztest" name="odom_hz_b">
    <param name="topic" value="/odom"/><param name="hz" value="50.0"/><param name="hzerror" value="10.0"/>
    <param name="test_duration" value="4.0"/>
  </test>
  <test test-name="imu_hz_b" pkg="rostest" type="hztest" name="imu_hz_b">
    <param name="topic" value="/imu/data_raw"/><param name="hz" value="50.0"/><param name="hzerror" value="10.0"/>
    <param name="test_duration" value="4.0"/>
  </test>
  <test test-name="drive_b" pkg="luchs_driver" type="drive_check.py" name="drive_b" args="b"/>
</launch>
