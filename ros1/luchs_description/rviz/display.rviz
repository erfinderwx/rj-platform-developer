Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
    - Class: rviz/TF
      Name: TF
      Enabled: false
  Global Options:
    Fixed Frame: base_footprint
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 4.0
      Pitch: 0.5
      Yaw: 0.8
