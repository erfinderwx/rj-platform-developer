<?xml version="1.0"?>
<!--
  Luchs B - top-level robot description.
  Chassis: RJ Tech Limited. Software / description: TerraAgent Robotics.

  xacro args:
    variant       : standard | cooling   (default standard; colour only)
    prefix        : string prepended to every link and joint name (default "")
    laser_example : true | false, adds the example laser_link mount (default true)

  Example:
    xacro luchs_b.urdf.xacro prefix:=robot1_
-->
<robot name="luchs_b" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="variant" default="standard"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="laser_example" default="true"/>

  <xacro:include filename="$(find luchs_description)/urdf/luchs_b_macro.xacro"/>

  <xacro:luchs_b prefix="$(arg prefix)" variant="$(arg variant)" laser_example="$(arg laser_example)"/>
</robot>
