<?xml version="1.0"?>
<package format="3">
  <name>luchs_msgs</name>
  <version>1.1.0</version>
  <description>Message and service definitions for Luchs robot chassis (ROS 1; identical to the ROS 2 definitions).</description>
  <maintainer email="support@terraagent-robotics.com">TerraAgent Robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
</package>
